{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "target": "ES2021",
    "esModuleInterop": true,
    "moduleResolution": "node"
  },
  "exclude": ["node_modules", "tmp"],
  "include": ["src/**/*"]
}
