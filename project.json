{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "view-a-LOD",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "sourceRoot": "src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "dist/view-a-lod",
        "index": "src/index.html",
        "browser": "src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "src/favicon.ico",
          "src/assets",
          {
            "glob": "**/*",
            "input": "node_modules/ng2-pdfjs-viewer/pdfjs",
            "output": "/assets/pdfjs"
          }
        ],
        "styles": [
          "src/styles.scss",
          "src/theme.scss",
          "node_modules/leaflet/dist/leaflet.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "externalDependencies": [
            "http",
            "https",
            "url",
            "util",
            "net"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.settings.ts",
              "with": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.production.settings.ts"
            },
            {
              "replace": "src/app/config/razu-settings/settings/matomo/razu-matomo.settings.ts",
              "with": "src/app/config/razu-settings/settings/matomo/razu-matomo.production.settings.ts"
            }
          ]
        },
        "acceptance": {
          "externalDependencies": [
            "http",
            "https",
            "url",
            "util",
            "net"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.settings.ts",
              "with": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.acceptance.settings.ts"
            }
          ]
        },
        "test": {
          "externalDependencies": [
            "http",
            "https",
            "url",
            "util",
            "net"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.settings.ts",
              "with": "src/app/config/razu-settings/settings/endpoints/razu-endpoint.test.settings.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "dev-build": {
          "externalDependencies": [
            "http",
            "https",
            "url",
            "util",
            "net"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "view-a-LOD:build:production"
        },
        "development": {
          "buildTarget": "view-a-LOD:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "view-a-LOD:build"
      }
    },
    "test": {
      "executor": "@angular/build:karma",
      "options": {
        "polyfills": [
          "zone.js",
          "zone.js/testing"
        ],
        "tsConfig": "tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "src/favicon.ico",
          "src/assets",
          {
            "glob": "**/*",
            "input": "node_modules/ng2-pdfjs-viewer/pdfjs",
            "output": "/assets/pdfjs"
          }
        ],
        "styles": [
          "src/styles.scss",
          "src/theme.scss",
          "node_modules/leaflet/dist/leaflet.css"
        ],
        "scripts": []
      }
    }
  }
}